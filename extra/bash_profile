# Function to invoke the autolfs installation process.
# Arguments:
#   - OPT: An optional argument to pass to the install.sh script (e.g., install options).
# Returns:
#   - Echoes messages about the installation process, including successful matches, errors, and any failure details.
#   - Allows the user to return to the sources directory after installation.
# Description:
#   This function starts the autolfs installation by invoking the `install.sh` script from the parent directory,
#   checks for any failed installation steps by grepping for failure indicators, and provides feedback to the user.
#   It also allows users to return to the sources directory after installation to continue their work.

function autolfs {
	OPT=$1
	ZEROTEST_SHOPT_ENABLED=$(shopt extglob)
	shopt -s extglob
	cd ..
	./install.sh $OPT
	INSTALL_EXIT_STATUS=$?
	FAILGREP=$(grep -E --line-number --color=always "\<FAIL" script)
	if [[ $? != 1 ]]; then
		# TODO LINENUM
		echo "grep FAIL script returned these matches"
		echo "---------------------------------------"
		echo "$FAILGREP"
		echo "---------------------------------------"
	fi
	if [[  $INSTALL_EXIT_STATUS == 0 ]]; then
		echo -e "\n\/\/ /sources/journal \/\/"
		tail -n3 $LFS/sources/journal | grep -B2 --color=always $(basename $PWD)
		echo -E "/\/\ /sources/journal /\\/\\"

		# echo "$TAIL_JOURNAL"
		echo -e "\nno errors (excluding test commands),"
		echo "you can review cmdsrun or script now here"
		echo "or return to the sources directory to move on."
		echo -e "currently in \033[1m$PWD\033[0m"
		read -N1 -p "return to sources directory [y]? "
		if [[ "$REPLY" != +([nN]) ]]; then popd 2>/dev/null
			if [[ ! $? == 0 ]]; then cd $LFS/sources; fi
		fi
		echo ""
	fi
	if [[ $ZEROTEST_SHOPT_ENABLED != 0 ]]; then shopt -u extglob; fi
}

# Function to search for terms in the /sources/journal file and display matching lines.
# Arguments:
#   - A list of search terms to find in the /sources/journal file.
# Returns:
#   - Echoes the matching lines found in the journal for each term, or an error message if no matches are found.
#   - Displays a list of search terms that had no matches.
# Description:
#   This function searches for the specified terms in the /sources/journal file. If matches are found, they are
#   displayed; otherwise, a message is shown for failed terms. The function supports multiple search terms and 
#   handles case-insensitive, exact string searches.

checkfor() {
    if [[ $# -eq 0 ]]; then
        echo "No search terms provided."
        return 1
    fi

    local successful_matches=()  # Array to store matching lines
    local failed_matches=()      # Array to store failed search terms

    for term in "$@"; do
        local matches=$(grep -i -F "$term" /sources/journal)  # Case-insensitive search for exact matches
        if [[ -n $matches ]]; then
            successful_matches+=("$matches")  # Store successful matches
        else
            failed_matches+=("$term")  # Store failed terms
        fi
    done

    if [[ ${#successful_matches[@]} -gt 0 ]]; then
        echo "Successful matches:"
        printf "%s\n" "${successful_matches[@]}"  # Print all successful matches
    else
        echo "No matches found in the journal."
    fi

    if [[ ${#failed_matches[@]} -gt 0 && ${failed_matches[0]} ]]; then
        echo "Failed matches:"
        printf "%s\n" "${failed_matches[@]}"  # Print failed terms
    fi

    if [[ ${#failed_matches[@]} -eq 0 && ${#successful_matches[@]} -gt 0 ]]; then
        echo -e "\033[1mAll matches were found.\033[0m"  # If all terms match, print success message
    fi
}

